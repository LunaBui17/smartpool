menu "DS18B20 Configuration"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    config DS18B20_GPIO
        int "1-Wire data GPIO"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 15
        help
            GPIO connected to the DS18B20 DQ pin. Add an external 4.7 kOhm
            pull-up resistor between DQ and 3.3 V.

    config DS18B20_MAX_DEVICES
        int "Maximum number of DS18B20 sensors"
        range 1 16
        default 2
        help
            Maximum number of sensors to discover on the shared 1-Wire bus.

    config DS18B20_READ_INTERVAL_MS
        int "Temperature read interval (ms)"
        range 1000 3600000
        default 1000
        help
            Delay between temperature readings in milliseconds.

endmenu

menu "Relay Configuration"

    config RELAY_1_GPIO
        int "Relay 1 GPIO"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 16
        help
            GPIO connected to relay module input IN1.

    config RELAY_2_GPIO
        int "Relay 2 GPIO"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 17
        help
            GPIO connected to relay module input IN2.

endmenu

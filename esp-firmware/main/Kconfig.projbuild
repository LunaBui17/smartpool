menu "DS18B20 Configuration"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    config DS18B20_GPIO
        int "1-Wire data GPIO"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 15
        help
            GPIO connected to the DS18B20 DQ pin. Add an external 4.7 kOhm
            pull-up resistor between DQ and 3.3 V.

    config DS18B20_MAX_DEVICES
        int "Maximum number of DS18B20 sensors"
        range 1 16
        default 2
        help
            Maximum number of sensors to discover on the shared 1-Wire bus.

    config DS18B20_READ_INTERVAL_MS
        int "Temperature read interval (ms)"
        range 1000 3600000
        default 1000
        help
            Delay between temperature readings in milliseconds.

endmenu

menu "Water Level Configuration"

    config WATER_LEVEL_GPIO
        int "Analog water level GPIO"
        range 1 20
        default 18
        help
            Analog output of the water level sensor. GPIO18 is ADC2 channel 7
            on ESP32-S3. Keep the sensor output at or below 3.3 V.

    config WATER_LOW_THRESHOLD
        int "Low water ADC threshold"
        range 0 4095
        default 2000
        help
            ADC readings below this value mean low water. Calibrate using the
            raw ADC value printed in the serial log.

endmenu

menu "Smart Pool Network"

    config POOL_SETUP_AP_SSID
        string "Setup access point SSID"
        default "SmartPool-Setup"

    config POOL_SETUP_AP_PASSWORD
        string "Setup access point password"
        default "12345678"
        help
            Use 8 to 63 characters. Users connect to this access point and
            open http://192.168.4.1 to enter their home Wi-Fi credentials.

    config POOL_API_URL
        string "XAMPP API URL"
        default "http://192.168.10.214/pool_api/pool_api.php"

    config POOL_MQTT_URI
        string "MQTT broker URI"
        default "mqtts://24660077a88741378be5ffe7f979f2f3.s1.eu.hivemq.cloud:8883"

    choice POOL_CONTROL_TRANSPORT
        prompt "Pump control transport"
        default POOL_CONTROL_MQTT
        help
            Select whether pump commands come from HiveMQ Cloud or the
            XAMPP API. Telemetry continues to use HTTP in either mode.

        config POOL_CONTROL_MQTT
            bool "MQTT (HiveMQ Cloud)"

        config POOL_CONTROL_HTTP
            bool "HTTP polling (XAMPP)"
    endchoice

endmenu

menu "Relay Configuration"

    choice RELAY_ACTIVE_LEVEL
        prompt "Relay input active level"
        default RELAY_ACTIVE_HIGH
        help
            Select the GPIO level that energizes the relay. Active HIGH
            matches modules whose relay indicator turns on at GPIO HIGH.

        config RELAY_ACTIVE_HIGH
            bool "HIGH activates relay"

        config RELAY_ACTIVE_LOW
            bool "LOW activates relay"
    endchoice

    config RELAY_1_GPIO
        int "Relay 1 GPIO"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 16
        help
            GPIO connected to relay module input IN1.

    config RELAY_2_GPIO
        int "Relay 2 GPIO"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 17
        help
            GPIO connected to relay module input IN2.

endmenu

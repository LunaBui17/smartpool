{
  "info": {
    "name": "Smart Pool 008 - admin registration / MAC inventory / deletion",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual isolated fixtures only; not executed. Admin register requires unique ID+MAC+shared_device_key; ESP cannot create bindings. Supply local admin_token,user_token,shared_device_key. user_token is a non-admin account. Requests in DELETE FIXTURE folder archive/delete A and free MAC: only use throwaway fixtures. Do not export secret responses."
  },
  "variable": [
    {
      "key": "api_url",
      "value": ""
    },
    {
      "key": "device_a",
      "value": ""
    },
    {
      "key": "device_b",
      "value": ""
    },
    {
      "key": "factory_mac_a",
      "value": ""
    },
    {
      "key": "factory_mac_b",
      "value": ""
    },
    {
      "key": "device_c",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Admin - create shared key (optional; copy into local variable only)",
      "request": {
        "method": "POST",
        "url": "{{api_url}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"create_shared_device_credential\",\n  \"label\": \"Manual shared-key fixture\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 201\",()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },

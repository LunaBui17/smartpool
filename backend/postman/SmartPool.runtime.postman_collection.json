{
  "info": {
    "name": "Smart Pool runtime 005 - manual isolated fixture",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy từng request thủ công trên device fixture riêng đã đăng ký/active, không dùng ID ESP thật. Không chạy collection này trên thiết bị đang vận hành. Điền user_token/device_key bằng local variables, không export secret. Request report_status mô phỏng OFF và config applied; không chứng minh ESP đã áp dụng. OFF request_control có thể được worker gửi MQTT nếu fixture có presence, không publish MQTT trực tiếp từ Postman. Không tự tạo user/device/key. Xem docs/esp-api-mqtt-runtime.md. Chưa chạy kiểm thử."
  },
  "variable": [
    {
      "key": "api_url",
      "value": ""
    },
    {
      "key": "device_id",
      "value": ""
    },
    {
      "key": "other_device_id",
      "value": ""
    },
    {
      "key": "desired_revision",
      "value": "1"
    },
    {
      "key": "expected_revision",
      "value": "1"
    },
    {
      "key": "command_id",
      "value": ""
    },
    {
      "key": "boot_id",
      "value": "0123456789abcdef0123456789abcdef"
    }
  ],
  "item": [
    {
      "name": "01 User - status/readiness",
      "request": {
        "method": "POST",
        "url": "{{api_url}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"action\":\"get_status\",\"device_id\":\"{{device_id}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of [\"api_url\",\"device_id\",\"user_token\"]) if (!pm.variables.get(key)) throw new Error(\"Set local variable: \"+key);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Runtime readiness fields',()=>{const d=pm.response.json();pm.expect(d.readiness).to.have.keys('ready','reasons','http_report','mqtt_presence','worker');pm.expect(d.remote_control_ready).to.eql(d.readiness.ready);});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 User - read config/revision",
      "request": {
        "method": "POST",
        "url": "{{api_url}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"action\":\"get_config\",\"device_id\":\"{{device_id}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of [\"api_url\",\"device_id\",\"user_token\"]) if (!pm.variables.get(key)) throw new Error(\"Set local variable: \"+key);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const r=pm.response.json().config.revision;pm.collectionVariables.set('desired_revision',r);pm.collectionVariables.set('expected_revision',r);}"
            ]
          }
        }
      ]
    },

        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Config belongs to fixture',()=>pm.expect(pm.response.json().config.device_id).to.eql(pm.variables.get('device_id')));"
            ]
          }
        }
      ]
    },

        "body": {
          "mode": "raw",
          "raw": "{\"action\":\"report_status\",\"device_id\":\"{{device_id}}\",\"boot_id\":\"{{boot_id}}\",\"state_sequence\":1,\"pump_in\":false,\"pump_out\":false,\"temperature_enabled\":true,\"water_enabled\":true,\"reported_config_revision\":{{desired_revision}},\"config_apply\":{\"attempt_sequence\":1,\"revision\":{{desired_revision}},\"result\":\"applied\"}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of [\"api_url\",\"device_id\",\"device_key\"]) if (!pm.variables.get(key)) throw new Error(\"Set local variable: \"+key);"
            ]

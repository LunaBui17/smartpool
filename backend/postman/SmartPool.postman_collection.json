{
  "info": {
    "name": "Smart Pool - Database via API",
    "description": "Verify pool_status, pool_history, pool_commands, pool_users and pool_user_sessions through the PHP API. Set password locally before running. Login creates a temporary session; logout revokes it. No sensor samples or pump commands are submitted.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "api_url",
      "value": "http://192.168.60.87/pool_api/pool_api.php"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Read latest sensor status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{api_url}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pool_status row 1\", () => { const d = pm.response.json(); pm.expect(d.id).to.eql(1); pm.expect(d).to.have.property(\"nhiet_do\"); pm.expect(d).to.have.property(\"muc_nuoc_raw\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Read measurement history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{api_url}}?history=1&limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"History array (empty is valid)\", () => { const d = pm.response.json(); pm.expect(d).to.be.an(\"array\"); pm.expect(d.length).to.be.at.most(10); d.forEach(row => { pm.expect(row).to.have.property(\"sample_id\"); pm.expect(row).to.have.property(\"received_at\"); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Read pump command state",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{api_url}}?commands=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Command state readable\", () => { const d = pm.response.json(); pm.expect(d.revision).to.be.a(\"number\"); pm.expect(d.bom_vao).to.be.oneOf([0, 1]); pm.expect(d.bom_ra).to.be.oneOf([0, 1]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Login - create database session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_url}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"login\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"remember_me\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"token\");",
              "if (!pm.variables.get(\"password\")) { throw new Error(\"Set your admin password locally before running login.\"); }",
              "pm.request.body.update(JSON.stringify({action:\"login\",username:pm.variables.get(\"username\"),password:pm.variables.get(\"password\"),remember_me:false}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Success\", () => pm.expect(pm.response.json().status).to.eql(\"success\"));",
              "pm.test(\"Admin session saved\", () => { const d = pm.response.json(); pm.expect(d.role).to.eql(\"admin\"); pm.expect(d.token).to.match(/^[a-f0-9]{64}$/); pm.collectionVariables.set(\"token\", d.token); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Read guests using saved session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{api_url}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"list_users\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Success\", () => pm.expect(pm.response.json().status).to.eql(\"success\"));",
              "pm.test(\"Guest list readable (empty is valid)\", () => pm.expect(pm.response.json().users).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Logout - delete database session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{api_url}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"logout\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Success\", () => pm.expect(pm.response.json().status).to.eql(\"success\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Confirm deleted session is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{api_url}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"list_users\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Revoked session rejected with HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.collectionVariables.unset(\"token\");"
            ]
          }
        }
      ]
    }
  ]
}

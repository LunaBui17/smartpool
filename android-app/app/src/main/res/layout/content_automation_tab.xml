<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/txtAutomationConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_modern"
            android:padding="14dp"
            android:text="Đang chờ kết nối tới ESP32…"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRefreshAutomation"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Tải cấu hình từ ESP32"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Mỗi bơm bật khi một trong các điều kiện được thỏa mãn. Ở chế độ theo ngưỡng, bơm dừng khi chạm một điều kiện tắt."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtAutomationWaterUnitInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngưỡng mực nước nhập theo cm và chỉ trong khoảng đo đã hiệu chuẩn."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/layoutAutomationPumps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Giới hạn thời gian là lớp bảo vệ tối đa. Nếu mất dữ liệu của cảm biến đang dùng để dừng, ESP32 sẽ dừng bơm an toàn. Cấu hình được lưu trực tiếp trên ESP32."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>

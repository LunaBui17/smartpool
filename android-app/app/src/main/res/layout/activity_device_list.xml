<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deviceListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp" android:background="@color/white">
        <TextView android:id="@+id/deviceListTitle"
            style="@style/PoolTitle" android:text="Thiết bị của bạn" />
        <TextView android:id="@+id/deviceListAccount"
            style="@style/PoolBody" android:layout_marginTop="4dp"
            android:maxLines="2" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnRefreshDevices"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="48dp" android:text="Tải lại" />
            <Button android:id="@+id/btnDeviceListLogout"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="48dp" android:text="Đăng xuất" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/adminOverviewContent"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:visibility="gone" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/PoolSectionTitle" android:text="Danh mục hệ thống" />
            <TextView android:id="@+id/adminOverviewSummary" style="@style/PoolBody"
                android:background="@drawable/bg_card_modern" android:padding="16dp"
                android:text="Đang tải danh mục..." android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/btnOverviewDevices"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="Quản lý thiết bị" android:layout_marginTop="16dp" />
            <Button android:id="@+id/btnOverviewUsers"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="Quản lý người dùng" />
            <TextView style="@style/PoolBody" android:layout_marginTop="16dp"
                android:text="Danh mục active/inactive không xác nhận ESP hoặc MQTT online. Mở từng thiết bị để xem báo cáo và điều khiển." />
            <TextView style="@style/PoolBody" android:layout_marginTop="12dp"
                android:text="Đang chờ API: mã user_code tùy chỉnh, sửa hồ sơ, lưu trữ/khôi phục và liên kết serial phần cứng. Giám sát nền vẫn tạm khóa; BLE chưa triển khai." />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/deviceListContent"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/btnRegisterDevice"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="Đăng ký thiết bị" android:visibility="gone" />
        <EditText android:id="@+id/deviceListSearch"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:hint="Tìm tên / ID trong danh sách đã tải"
            android:inputType="text" android:singleLine="true" />
        <TextView android:id="@+id/deviceListStatus"
            style="@style/PoolBody" android:layout_marginVertical="8dp"
            android:accessibilityLiveRegion="polite" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:id="@+id/deviceListItems"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
        <Button android:id="@+id/btnMoreDevices"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="Tải thêm thiết bị" android:enabled="false" />
    </LinearLayout>

    <include android:id="@+id/adminUsersContent" layout="@layout/content_users_tab" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/adminNavigation"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" android:visibility="gone"
        app:itemIconTint="@color/navigation_item"
        app:itemTextColor="@color/navigation_item"
        app:labelVisibilityMode="labeled" app:menu="@menu/admin_navigation" />
</LinearLayout>

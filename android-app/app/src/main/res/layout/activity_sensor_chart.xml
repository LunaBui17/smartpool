<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chartRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/btnChartBack"
                style="@style/PoolIconButton"
                android:contentDescription="Quay lại"
                android:src="@drawable/ic_back" />
            <TextView style="@style/PoolSectionTitle"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Lịch sử cảm biến" />
        </LinearLayout>
        <TextView android:id="@+id/txtChartTitle"
            style="@style/PoolTitle"
            android:layout_marginTop="24dp"
            android:text="Biểu đồ cảm biến" />
        <TextView android:id="@+id/txtChartStatus"
            style="@style/PoolBody"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="Đang tải dữ liệu..." />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnTemperatureTab"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Nhiệt độ" />
            <Button android:id="@+id/btnAdcTab"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" android:text="Mực nước" />
        </LinearLayout>
        <FrameLayout android:id="@+id/chartContainer"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="@drawable/bg_card_modern"
            android:padding="8dp" />
        <TextView style="@style/PoolCaption"
            android:layout_marginTop="16dp"
            android:text="Trục ngang là thời điểm máy chủ nhận dữ liệu, hiển thị theo giờ điện thoại. Mẫu gửi bù có thể không trùng thời điểm đo thực tế." />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tài khoản và phân quyền"
            android:textColor="@color/navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView style="@style/PoolBody" android:layout_marginTop="8dp"
            android:text="Quản lý tài khoản toàn hệ thống, không phụ thuộc thiết bị đang chọn. Mã user_code riêng, sửa hồ sơ và lưu trữ/khôi phục đang chờ API; không dùng id nội bộ làm mã tự đặt." />

        <Button android:id="@+id/btnToggleAdminUserForm"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="Tạo tài khoản mới" />

        <LinearLayout
            android:id="@+id/adminUserCreateForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_modern"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/edtUserUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:hint="Tên đăng nhập (3-64 ký tự)"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtUserPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="Mật khẩu (ít nhất 7 byte; để trống khi sửa nếu giữ nguyên)"
                android:inputType="textPassword"
                android:saveEnabled="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtUserStudentCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Mã sinh viên (tùy chọn; không phải user_code)"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/edtUserFullName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="Họ và tên tài khoản mới"
                android:inputType="textPersonName"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:labelFor="@id/spnUserRole"
                android:text="Vai trò tài khoản mới"
                android:textColor="@color/text_secondary" />

            <Spinner
                android:id="@+id/spnUserRole"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin có quyền trên mọi thiết bị. User cần được cấp quyền riêng. Không tự khóa tài khoản đang dùng hoặc admin cuối cùng."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchUserActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checked="true"
                android:text="Tài khoản đang hoạt động" />

            <Button
                android:id="@+id/btnSaveUser"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_primary"
                android:text="Tạo tài khoản"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelUserEdit"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Hủy chỉnh sửa"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Danh sách tài khoản"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText android:id="@+id/edtAdminUserSearch"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:hint="Tìm tài khoản trong danh sách đã tải"
            android:inputType="text" android:singleLine="true" />
        <TextView android:id="@+id/txtAdminUsersStatus" style="@style/PoolBody"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:id="@+id/layoutUserList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
        <Button android:id="@+id/btnMoreAdminUsers"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="Tải thêm tài khoản" android:enabled="false" />
    </LinearLayout>
</ScrollView>

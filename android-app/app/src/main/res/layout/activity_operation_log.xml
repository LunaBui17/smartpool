<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/operationLogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton android:id="@+id/btnLogBack"
            style="@style/PoolIconButton"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_back" />
        <TextView style="@style/PoolSectionTitle"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="Lịch sử hoạt động" />
    </LinearLayout>
    <TextView style="@style/PoolTitle"
        android:layout_marginTop="20dp" android:text="Nhật ký thao tác" />
    <TextView android:id="@+id/txtLogStatus"
        style="@style/PoolCaption"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/btnRefreshLog"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_primary"
        android:text="Đồng bộ và tải lại" android:textColor="@color/white" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout android:id="@+id/layoutOperationLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>

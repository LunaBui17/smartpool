<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smart Pool"
                android:textColor="@color/navy"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnLogout"
                style="@style/PoolCaption"
                android:layout_width="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:text="Đăng xuất"
                android:textColor="@color/blue_dark" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/btnOpenOperationLog"
            style="@style/PoolIconButton"
            android:contentDescription="Nhật ký thao tác"
            android:src="@drawable/ic_history" />
        <ImageButton
            android:id="@+id/btnOpenSettings"
            style="@style/PoolIconButton"
            android:layout_marginStart="8dp"
            android:contentDescription="Cài đặt"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtActionFeedback"
        style="@style/PoolBody"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/alertBannerContainer"
                style="@style/PoolCard"
                android:background="@drawable/bg_alert_banner"
                android:visibility="gone">
                <TextView
                    android:id="@+id/txtAlert"
                    style="@style/PoolBody"
                    android:textColor="@color/danger" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dashboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/PoolCard"
                    android:background="@drawable/bg_header_gradient"
                    android:padding="20dp">
                    <TextView style="@style/PoolCaption"
                        android:text="TỔNG QUAN BỂ BƠI"
                        android:textColor="@color/cyan_soft" />
                    <TextView
                        android:id="@+id/txtHeaderSubtitle"
                        style="@style/PoolSectionTitle"
                        android:text="Hệ thống Smart Pool"
                        android:textColor="@color/white"
                        android:textSize="20sp" />
                    <TextView
                        android:id="@+id/txtDeviceBadge"
                        style="@style/PoolBody"
                        android:textColor="@color/cyan_soft"
                        android:textIsSelectable="true" />
                    <TextView
                        android:id="@+id/txtControlModeBadge"
                        style="@style/PoolCaption"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_on_dark" />
                    <TextView
                        android:id="@+id/txtGeneralStatus"
                        style="@style/PoolCaption"
                        android:layout_marginTop="12dp"
                        android:text="Đang kiểm tra kết nối..."
                        android:textColor="@color/text_on_dark" />
                </LinearLayout>

                <TextView style="@style/PoolSectionTitle" android:text="Chất lượng nước" />
                <TextView style="@style/PoolCaption"
                    android:layout_marginBottom="12dp"
                    android:text="Chạm vào số đo để xem biểu đồ theo thời gian." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <LinearLayout style="@style/PoolCard"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:padding="14dp">
                        <TextView style="@style/PoolBody"
                            android:text="Nhiệt độ"
                            android:textColor="@color/temp_accent"
                            android:textStyle="bold" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/txtTemp"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="Mở biểu đồ nhiệt độ"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:maxLines="2"
                            android:text="--.- °C"
                            android:textColor="@color/navy"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="30sp"
                            app:autoSizeMinTextSize="16sp"
                            app:autoSizeTextType="uniform" />
                        <TextView android:id="@+id/txtTempStatus"
                            style="@style/PoolCaption" android:text="Đang chờ số đo" />
                        <TextView android:id="@+id/txtTempThresholdInfo"
                            style="@style/PoolCaption" android:layout_marginTop="10dp" />
                    </LinearLayout>
                    <LinearLayout style="@style/PoolCard"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:padding="14dp">
                        <TextView style="@style/PoolBody"
                            android:text="Mực nước"
                            android:textColor="@color/water_accent"
                            android:textStyle="bold" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/txtWater"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="Mở biểu đồ mực nước"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:maxLines="2"
                            android:text="Chờ dữ liệu"
                            android:textColor="@color/navy"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="30sp"
                            app:autoSizeMinTextSize="16sp"
                            app:autoSizeTextType="uniform" />
                        <TextView android:id="@+id/txtWaterStatus"
                            style="@style/PoolCaption" android:text="Đang chờ số đo" />
                        <TextView android:id="@+id/txtWaterThresholdInfo"
                            style="@style/PoolCaption" android:layout_marginTop="10dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/txtUpdated" style="@style/PoolCaption"
                    android:text="Chưa có dữ liệu cảm biến" />
                <TextView style="@style/PoolBody"
                    android:layout_marginTop="16dp"
                    android:text="Bật/tắt bơm và cảm biến trong Điều khiển. Xem kết nối từng thành phần trong Hệ thống." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/controlContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView style="@style/PoolTitle" android:text="Điều khiển thiết bị" />
                <TextView style="@style/PoolBody"
                    android:layout_marginTop="8dp" android:layout_marginBottom="16dp"
                    android:text="Chỉ cho phép thao tác khi MQTT kết nối và ESP32 báo online. Lệnh cần thiết bị xác nhận." />

                <TextView style="@style/PoolSectionTitle" android:text="Hệ thống bơm" />
                <LinearLayout style="@style/PoolCard">
                    <TextView style="@style/PoolSectionTitle" android:text="Bơm cấp nước" />
                    <TextView style="@style/PoolCaption" android:text="Từ bể phụ vào bể chính" />
                    <TextView android:id="@+id/txtPumpInStatus" style="@style/PoolBody"
                        android:layout_marginTop="8dp" android:text="Chờ trạng thái ESP32" />
                    <Button android:id="@+id/btnPumpIn"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:minHeight="52dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="Chờ thiết bị" android:textColor="@color/white" />
                </LinearLayout>
                <LinearLayout style="@style/PoolCard">
                    <TextView style="@style/PoolSectionTitle" android:text="Bơm thoát nước" />
                    <TextView style="@style/PoolCaption" android:text="Từ bể chính ra đường thoát" />
                    <TextView android:id="@+id/txtPumpOutStatus" style="@style/PoolBody"
                        android:layout_marginTop="8dp" android:text="Chờ trạng thái ESP32" />
                    <Button android:id="@+id/btnPumpOut"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:minHeight="52dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="Chờ thiết bị" android:textColor="@color/white" />
                </LinearLayout>

                <TextView style="@style/PoolSectionTitle" android:text="Cảm biến" />
                <LinearLayout style="@style/PoolCard">
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchTemperatureEnabled"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:contentDescription="Bật hoặc tắt cảm biến nhiệt độ"
                        android:enabled="false" android:minHeight="56dp"
                        android:text="Chờ thiết bị" android:textColor="@color/text_primary" />
                    <TextView style="@style/PoolCaption" android:text="Cảm biến nhiệt độ nước" />
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
                        android:background="@color/line" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchWaterEnabled"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:contentDescription="Bật hoặc tắt cảm biến mực nước"
                        android:enabled="false" android:minHeight="56dp"
                        android:text="Chờ thiết bị" android:textColor="@color/text_primary" />
                    <TextView style="@style/PoolCaption" android:text="Cảm biến mực nước" />
                </LinearLayout>
                <LinearLayout android:id="@+id/interlockControlSection" style="@style/PoolCard">
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchInterlock"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:checked="true" android:minHeight="48dp"
                        android:text="Khóa liên động"
                        android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/txtInterlockStatus" style="@style/PoolCaption"
                        android:layout_marginTop="8dp"
                        android:text="Ngăn hai bơm hoạt động cùng lúc." />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/systemStatusContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView style="@style/PoolTitle" android:text="Trạng thái hệ thống" />
                <TextView style="@style/PoolBody" android:layout_marginTop="8dp"
                    android:text="Theo dõi đường kết nối và trạng thái từng thành phần." />
                <TextView android:id="@+id/txtSystemStatusUpdated"
                    style="@style/PoolCaption" android:layout_marginTop="12dp" />
                <com.buiducluan23011767.ck.SystemStatusView
                    android:id="@+id/systemStatusDiagram"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:importantForAccessibility="yes" />
                <LinearLayout style="@style/PoolCard">
                    <TextView style="@style/PoolSectionTitle" android:text="Đọc lưu đồ" />
                    <TextView style="@style/PoolBody"
                        android:text="Xanh: bật hoặc kết nối\nXám: tắt hoặc chưa rõ\nCam: chờ xác nhận\nĐỏ: lỗi kết nối" />
                    <TextView style="@style/PoolCaption" android:layout_marginTop="12dp"
                        android:text="API và MQTT được theo dõi độc lập. Mất liên lạc không có nghĩa thiết bị đã tắt. Trạng thái MQTT gần nhất có thể là retained; bơm bật là trạng thái relay do ESP báo, không phải phản hồi cơ khí. Không dò trực tiếp tiến trình Docker hoặc Cloudflare." />
                </LinearLayout>
                <TextView android:id="@+id/protocolSectionTitle"
                    style="@style/PoolSectionTitle" android:text="Chi tiết kết nối" />
                <LinearLayout android:id="@+id/protocolDetailsSection" style="@style/PoolCard">
                    <TextView android:id="@+id/txtMqttBadge" style="@style/PoolBody"
                        android:text="MQTT: Đang kết nối..." android:textStyle="bold" />
                    <TextView android:id="@+id/txtConnection" style="@style/PoolCaption"
                        android:layout_marginTop="8dp" android:text="Đang kiểm tra API..." />
                    <TextView android:id="@+id/txtLocalWebAddress" style="@style/PoolBody"
                        android:layout_marginTop="16dp" />
                    <TextView android:id="@+id/txtHttpEndpointMatch" style="@style/PoolCaption"
                        android:layout_marginTop="8dp" />
                    <Button android:id="@+id/btnOpenLocalWeb"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Mở trang thiết bị trong LAN" />
                    <TextView android:id="@+id/txtMqttCurrentBroker" style="@style/PoolBody"
                        android:layout_marginTop="16dp" />
                    <TextView android:id="@+id/txtMqttCurrentTopics" style="@style/PoolCaption"
                        android:layout_marginTop="8dp" />
                    <Button android:id="@+id/btnGoToSettings"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:text="Cài đặt kết nối" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/mainNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/navigation_item"
        app:itemTextColor="@color/navigation_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_navigation" />
</LinearLayout>
